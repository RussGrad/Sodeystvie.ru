{
  "name": "sodeystvie.ru",
  "private": true,
  "description": "Инструменты разработки (Prisma Studio для PostgreSQL); сайт на PHP",
  "scripts": {
    "build:production": "bash scripts/build-sodeystvie-prod.sh",
    "build:css": "sass src/scss/main.scss public/css/main.css --style=compressed --no-source-map",
    "build:images": "node scripts/build-images-webp.mjs",
    "build": "npm run build:css && npm run build:images",
    "watch:css": "sass src/scss/main.scss public/css/main.css --watch --style=expanded --no-source-map",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "sass": "^1.99.0",
    "sharp": "^0.34.2"
  }
}
