# Скопируйте в .env в ЭТОЙ папке (рядом с index.php) на хостинге REG.RU.
# Файл .env в git не попадает.

CRM_API_BASE=https://an-realty-crm.ru
CRM_PUBLIC_BASE=https://an-realty-crm.ru
# Путь каталога на Nest (через nginx CRM доступен только под /api/)
CRM_LISTINGS_PATH=/api/public/listings
CRM_LEADS_PATH=/api/public/leads
CRM_SITE_CHAT_PATH=/api/public/site-chat

# Тот же ключ, что PUBLIC_SITE_API_KEY в apps/api/.env на CRM (заголовок X-Api-Key)
PUBLIC_SITE_API_KEY=сгенерируйте-openssl-rand-hex-32

# Слайдер на главной: auto = файлы assets/hero/hero-bg* (если есть), иначе фото из CRM
# static = только assets/hero | crm = только объекты CRM
HERO_SLIDES_SOURCE=auto

# Шапка и контакты: Telegram (канал/бот). Если пусто — ссылка t.me/+номер из SITE_PHONE_TEL
SITE_TELEGRAM_URL=https://t.me/your_channel

# Страница контактов: группа или сообщество ВКонтакте
SITE_VK_URL=https://vk.com/your_group

# Шапка: мессенджер MAX (max.ru) — ссылка на чат/профиль
SITE_MAX_URL=https://max.ru/
# SITE_CONTACTS_MESSENGERS_LEAD=Свяжемся в течение 15 минут.

# Бренд и домены (без смены названия «Содействие»)
# SITE_CANONICAL_HOST=an-sodeystvie.ru
# SITE_REDIRECT_HOSTS=www.an-sodeystvie.ru,sod-irk.ru
# SITE_SLOGAN_SHORT=Сделки под ключ
# SITE_HERO_HEADLINE=Безопасная покупка и продажа недвижимости в Иркутске
# SITE_SLOGAN_HERO=Полное юридическое сопровождение — от подбора объекта до получения ключей

# Реквизиты в подвале и на /about/ (обязательно для продакшена)
# SITE_LEGAL_INN=3808123456
# SITE_LEGAL_OGRN=1234567890123

# WebP: true = прокси /api/image.php для фото CRM; build:images для /assets/
# SITE_IMAGE_WEBP=true
# SITE_IMAGE_WEBP_QUALITY=78
# SITE_IMAGE_WEBP_MAX_WIDTH=1600

# Карта каталога: JavaScript API Яндекс.Карт (developer.tech.yandex.ru)
YANDEX_MAPS_API_KEY=
# SITE_MAP_CENTER_LAT=52.2896
# SITE_MAP_CENTER_LNG=104.2806
# SITE_MAP_DEFAULT_ZOOM=11
# Офис на /contacts/ (ул. Карла Либкнехта 107а)
# SITE_OFFICE_LAT=52.2796
# SITE_OFFICE_LNG=104.312
# SITE_OFFICE_ZOOM=16

# Отзывы: карточки — public/data/reviews-domclick.json (Домклик) и public/data/reviews.json (ручные)
# SITE_REVIEWS_PREVIEW_LIMIT=4
# SITE_REVIEWS_RATING= и SITE_REVIEWS_COUNT= — только если нет reviews-domclick.json
# Страницы организации (ссылки «Читать отзывы»):
# SITE_YANDEX_ORG_URL=https://yandex.ru/maps/org/название/1234567890/
# SITE_YANDEX_REVIEWS_COUNT=120
# SITE_2GIS_ORG_URL=https://2gis.ru/irkutsk/firm/70000001061295750/tab/reviews
# SITE_2GIS_REVIEWS_COUNT=5
# SITE_DOMCLICK_REVIEWS_URL=https://agencies.domclick.ru/agent/1034773
# SITE_DOMCLICK_REVIEWS_COUNT=14
# SITE_AVITO_REVIEWS_URL=https://www.avito.ru/user/.../profile
# SITE_AVITO_REVIEWS_COUNT=
# Счётчики также можно задать в public/data/reviews-platforms.json
# Отзывы с площадок: public/data/reviews-domclick.json, reviews-yandex.json, reviews-2gis.json
# Виджеты iframe на /reviews/ (опционально; Яндекс подставится из ORG_URL по ID):
# SITE_YANDEX_REVIEWS_WIDGET_SRC=https://yandex.ru/maps-reviews-widget/1234567890?comments
# SITE_2GIS_REVIEWS_WIDGET_SRC=https://widgets.2gis.com/...
# SITE_DOMCLICK_REVIEWS_WIDGET_SRC=
# SITE_AVITO_REVIEWS_WIDGET_SRC=

# Форма контактов: Google reCAPTCHA v2 (если пусто — виджет скрыт)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# --- Админка сайта (/admin/) ---
# Логин и хеш пароля (сгенерировать: php -r "echo password_hash('ваш-пароль', PASSWORD_DEFAULT);")
SITE_ADMIN_LOGIN=admin
SITE_ADMIN_PASSWORD_HASH=
# Временно можно plain-пароль (не рекомендуется на проде):
# SITE_ADMIN_PASSWORD=
# Ограничение по IP (через запятую), необязательно:
# SITE_ADMIN_IP_ALLOWLIST=
