# Защита конфигурации на shared-хостинге (Apache)
<FilesMatch "^(\.env|crm-config\.env|\.env\..*)$">
    Require all denied
</FilesMatch>

# Канонический домен: www → без www (доп. алиасы — SITE_REDIRECT_HOSTS в .env, см. site-brand.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.an-sodeystvie\.ru$ [NC]
    RewriteRule ^ https://an-sodeystvie.ru%{REQUEST_URI} [R=301,L]

    # Админка: /admin/ → index.php (на REG.RU без DirectoryIndex каталог даёт 404)
    RewriteRule ^admin/?$ /admin/index.php [L]

    # После покупки короткого домена раскомментируйте и укажите хост:
    # RewriteCond %{HTTP_HOST} ^(www\.)?sod-irk\.ru$ [NC]
    # RewriteRule ^ https://an-sodeystvie.ru%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
