# Скопируйте в .env и при необходимости измените (файл .env не коммитится)
#
# Локально поднимайте Nest CRM отдельно: в монорепе an-realty-crm выполните `pnpm api` (PORT см. apps/api/.env).
# WEB_PORT — порт витрины на хосте (8080 часто занят PHP CRM из an-realty-crm — см. их README).
WEB_PORT=8090

POSTGRES_USER=sodeystvie
POSTGRES_PASSWORD=sodeystvie_dev
POSTGRES_DB=sodeystvie

# Prisma Studio / CLI (подключение с хоста к Docker, порт 5432)
DATABASE_URL="postgresql://sodeystvie:sodeystvie_dev@localhost:5432/sodeystvie?schema=public"

# Nest CRM API (an-realty-crm, PORT в apps/api/.env — здесь ожидается 3000). Docker подставляет эти переменные в контейнер web.
# Для PHP на хосте без Docker достаточно значений ниже; в Docker server-side запросы идут на host.docker.internal (см. config.php).
CRM_API_BASE="http://localhost:3000"
CRM_PUBLIC_BASE="http://localhost:3000"

# --- Продакшен (REG.RU): см. public/.env.example → скопировать в public/.env на хостинге ---
# CRM_API_BASE=https://an-realty-crm.ru
# CRM_PUBLIC_BASE=https://an-realty-crm.ru
# CRM_LISTINGS_PATH=/api/public/listings
